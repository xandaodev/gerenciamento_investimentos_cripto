# Senha do usuário root do MySQL criado pelo Docker Compose
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password

# Usuário da aplicação no banco
# No Docker Compose, DB_USER não pode ser "root": a imagem do MySQL usa
# MYSQL_USER somente para criar um usuário comum
DB_USER=criptovision
DB_PASSWORD=replace-with-a-strong-password

# Substitua por um segredo longo e aleatório
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Origens do frontend autorizadas a chamar a API pelo navegador (CORS),
# separadas por vírgula. Use esquema, host e porta opcional, sem caminho nem "*".
# Em produção, informe só o domínio do frontend, por exemplo:
# CORS_ALLOWED_ORIGINS=https://app.seudominio.com.br
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Configuração da integração com cotações
COTACOES_CONNECT_TIMEOUT=3s
COTACOES_READ_TIMEOUT=5s
COTACOES_CACHE_TTL=60s
COTACOES_CACHE_MAX_STALE=15m

# Endpoint público de dados de mercado da Binance
BINANCE_API_BASE_URL=https://data-api.binance.vision/api/v3
