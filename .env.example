# Banco de dados usado no ambiente local e no Docker Compose
DB_USER=root
DB_PASSWORD=root

# Substitua por um segredo longo e aleatório
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Configuração da integração com cotações
COTACOES_CONNECT_TIMEOUT=3s
COTACOES_READ_TIMEOUT=5s
COTACOES_CACHE_TTL=60s
COTACOES_CACHE_MAX_STALE=15m

# Endpoint público de dados de mercado da Binance
BINANCE_API_BASE_URL=https://data-api.binance.vision/api/v3
