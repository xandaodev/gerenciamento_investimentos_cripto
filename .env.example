# Senha do usuário root do MySQL criado pelo Docker Compose
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password

# Usuário da aplicação no banco
# No Docker Compose, DB_USER não pode ser "root": a imagem do MySQL usa
# MYSQL_USER somente para criar um usuário comum
#
# Gere as senhas do banco com "openssl rand -hex 24". Evite \ e ': a imagem do
# MySQL monta o SQL de criação do usuário com a senha entre aspas simples e
# descarta a barra invertida, então a senha gravada ficaria diferente da do .env
DB_USER=criptovision
DB_PASSWORD=replace-with-a-strong-password

# Segredo que assina os tokens JWT, com ao menos 32 bytes. Gere com
# "openssl rand -base64 48". A aplicação não sobe com um segredo menor nem com
# este valor de exemplo. Trocar o segredo invalida todos os tokens emitidos
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Origens do frontend autorizadas a chamar a API pelo navegador (CORS),
# separadas por vírgula. Use esquema, host e porta opcional, sem caminho nem "*".
# Em produção, informe só o domínio do frontend, por exemplo:
# CORS_ALLOWED_ORIGINS=https://app.seudominio.com.br
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Produção (VPS): domínio público da API, para o qual o Caddy emite o certificado
# HTTPS. O DNS do domínio precisa apontar para o IP da VPS. Deixe vazio em
# desenvolvimento. Exemplo: DOMINIO=api.seudominio.com.br
DOMINIO=

# Produção (VPS): descomente para que "docker compose up" também suba o Caddy
# e o backup, sem precisar de "--profile producao" em todo comando
# COMPOSE_PROFILES=producao

# --- Backup do MySQL (serviço "backup", perfis "producao" e "backup") ---------
#
# Senha que cifra os backups (gpg, AES-256), com ao menos 20 caracteres. Gere com
# "openssl rand -base64 32" e GUARDE UMA CÓPIA FORA DO SERVIDOR, num gerenciador
# de senhas: sem ela, nenhum backup pode ser restaurado, nem a partir do bucket.
# Ela nunca é enviada ao bucket
BACKUP_SENHA=

# Horário do backup diário, em UTC (03:00 UTC = 00:00 em Brasília)
BACKUP_HORARIO=03:00

# Por quantos dias guardar os backups no servidor e no bucket
# (0 no bucket desliga a limpeza; use então uma regra de ciclo de vida do bucket)
BACKUP_RETENCAO_DIAS=14
BACKUP_RETENCAO_REMOTA_DIAS=30

# Testa a restauração do backup mais recente todo domingo
BACKUP_TESTE_SEMANAL=true

# Bucket S3 para a cópia fora do servidor. Sem BACKUP_S3_BUCKET, os backups ficam
# só no servidor e cada backup registra um aviso no log. Veja no README como criar
# o bucket e uma credencial com acesso só a ele.
#   Cloudflare R2:  BACKUP_S3_PROVEDOR=Cloudflare
#                   BACKUP_S3_ENDPOINT=https://<ID_DA_CONTA>.r2.cloudflarestorage.com
#                   BACKUP_S3_REGIAO=auto
#   Backblaze B2:   BACKUP_S3_PROVEDOR=Other
#                   BACKUP_S3_ENDPOINT=https://s3.<regiao>.backblazeb2.com
#                   BACKUP_S3_REGIAO=<regiao>, por exemplo us-west-004
#   AWS S3:         BACKUP_S3_PROVEDOR=AWS
#                   BACKUP_S3_ENDPOINT=https://s3.<regiao>.amazonaws.com
#                   BACKUP_S3_REGIAO=<regiao>, por exemplo sa-east-1
BACKUP_S3_PROVEDOR=Other
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGIAO=auto
BACKUP_S3_BUCKET=
BACKUP_S3_PASTA=criptovision
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# Configuração da integração com cotações
COTACOES_CONNECT_TIMEOUT=3s
COTACOES_READ_TIMEOUT=5s
COTACOES_CACHE_TTL=60s
COTACOES_CACHE_MAX_STALE=15m

# Endpoint público de dados de mercado da Binance
BINANCE_API_BASE_URL=https://data-api.binance.vision/api/v3
